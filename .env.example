# Runtime provider: local or online
RAG_GENERATION_PROVIDER=local

# Online generation settings, used only when RAG_GENERATION_PROVIDER=online
RAG_ONLINE_MODEL_NAME=gpt-5.5
RAG_ONLINE_API_BASE_URL=https://relayai.tech/v1
RAG_ONLINE_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=

# Retrieval models and thresholds
RAG_EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
RAG_RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RAG_MODEL_RERANK_WEIGHT=0.01
RAG_MIN_VECTOR_SCORE=0.40
RAG_FAISS_STORE_DIR=data/faiss_store

# Answer stabilization
RAG_ANSWER_COMPOSER_ENABLED=true
# on: 总是用主证据重组回复；off: 完全不介入；auto: 只在模型输出低质量时介入
RAG_ANSWER_COMPOSER_MODE=auto
RAG_REPLY_RULES_ENABLED=true

# Optional hot context cache. If unset or unavailable, the app falls back to SQLite.
REDIS_URL=
CHAT_RECENT_MESSAGES_TTL_SECONDS=86400
CHAT_RISK_STATE_TTL_SECONDS=86400
CHAT_REQUEST_TTL_SECONDS=600
CHAT_SUMMARY_TTL_SECONDS=604800
CHAT_RECENT_MESSAGES_LIMIT=10

# ---------------------------------------------------------------- 数据接入 / 鉴权
#
# 元数据连接串。只从环境变量读取，代码里不允许硬编码。
# 本机开发（无 Docker / 无 PostgreSQL）留空即用默认 SQLite：data/rag_metadata.db
# 有 PostgreSQL 时改成：
#   RAG_DATABASE_URL=postgresql+psycopg://rag:rag@127.0.0.1:5432/rag_metadata
RAG_DATABASE_URL=

# JWT 校验参数。生产环境的密钥只能来自环境变量 / 密钥管理服务，
# 绝不写入仓库；缺失 SECRET 时服务在启动阶段直接报错，不降级放行。
RAG_JWT_SECRET=
RAG_JWT_ALGORITHM=HS256
RAG_JWT_ISSUER=llm-customer-service
RAG_JWT_AUDIENCE=customer-service-api
# 允许的时钟偏移（秒），用于容忍签发方与本机的轻微时间差
RAG_JWT_LEEWAY_SECONDS=30

# 对象存储：第一期本地目录，生产切换 S3 兼容存储只改这里
RAG_OBJECT_STORE_DRIVER=local
RAG_OBJECT_STORE_LOCAL_ROOT=data/object_store
RAG_UPLOAD_MAX_MB=50

# 任务队列。Redis Stream 为正式实现；留空时降级到进程内内存队列（仅供单机开发）。
RAG_REDIS_STREAM_URL=
RAG_INGESTION_STREAM_KEY=rag:ingestion:jobs
RAG_INGESTION_CONSUMER_GROUP=rag-workers
